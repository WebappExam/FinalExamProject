@model StudyRoomBooking.Mvc.viewModel.RoomBookingCreateViewModel

@{
    ViewData["Title"] = "Opprett rombooking";
}
<h1>Book @Model.RoomName</h1>

<form asp-controller="RoomBooking" asp-action="Create" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @*Identifiserer rom som skal bookes*@
    <input asp-for="RoomId" type="hidden" />

    <div class="mb-3">
        <label asp-for="StartTime" class="form-label">Velg Startid:</label>
        <input asp-for="StartTime"
        asp-format="{0:yyyy-MM-ddTHH:mm}"
            type="datetime-local"
            step="60"
            class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>

            <div class ="mb-3">
            <label asp-for= "EndTime" class ="form-label">Sluttid</label>
            <input asp-for="EndTime"
            asp-format="{0:yyyy-MM-ddTHH:mm}"
            type="datetime-local"
            step="60"
            class= "form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
                </div>

                  <div class ="mb-3">
            <label asp-for= "Course" class ="form-label">Kursnavn</label>
            <input asp-for="Course"
                class= "form-control" />
                <span asp-validation-for="Course" class="text-danger"></span>
                </div>

                       <div class ="mb-3">
            <label asp-for="Description" class="form-label">Beskrivelse (valgfritt)</label>
            
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
                </div>

        @*Aktiveres når lagring av booking er klar*@
        <button type="submit" class="btn btn-primary">Book rom
        </button>

        <a asp-controller="RoomLocation"
        asp-action="Index"
        class="btn btn-secondary">
        Tilbake til lokasjoner
        </a>
        </form>

