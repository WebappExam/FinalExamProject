@model List<StudyRoomBooking.Mvc.viewModel.RoomBookingListViewModel>

    @{
        ViewData ["Title"] = "Mine bookinger";
    }

    <h1>Mine bookinger</h1>

    @if (Model.Count == 0)
{
    <p>Du har ingen bookinger</p>
}
    else
{
    <div class = "table-responsive">
        <table class = "table table-striped">
            <thead>
                <tr>

                    <th>Rom</th>
                    <th>Bygg</th>
                    <th>Kursnavn</th>
                    <th>Startid</th>
                    <th>Sluttid</th>
                    </tr>
            </thead>

            <tbody>
                @*Viser en rad for hver booking*@
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.RoomName</td>
                        <td>@booking.Building</td>
                        <td>@booking.Course</td>
                        <td>@booking.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@booking.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                     </tr>
                }
                </tbody>
            </table>
        </div>
    }

                <a asp-controller = "RoomLocation"
            asp-action="="Index"
        class "btn btn-secondary">
        Tilbake til lokasjoner
    </a>