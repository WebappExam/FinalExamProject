@model List<StudyRoomBooking.Mvc.viewModel.RoomBookingListViewModel>

    @{
        ViewData ["Title"] = "Mine bookinger";
    }

    <h1>Mine bookinger</h1>

    @* Viser eventuell feilmelding etter forsøk på kansellering. *@
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger fw-bold" role="alert">
        @errorMessage
    </div>
}

    @if (Model.Count == 0)
{
    <p>Du har ingen bookinger</p>
}
    else
{
    <div class = "table-responsive">
        <table class = "table table-striped">
            <thead>
                <tr>
                    <th>Rom</th>
                    <th>Bygg</th>
                    <th>Kursnavn</th>
                    <th>Startid</th>
                    <th>Sluttid</th>
                    <th>Handling</th>
                    </tr>
            </thead>

            <tbody>
                @*Viser en rad for hver booking*@
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.RoomName</td>
                        <td>@booking.Building</td>
                        <td>@booking.Course</td>
                        <td>@booking.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@booking.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            <form asp-controller="RoomBooking"
                            asp-action="Cancel"
                            method="post">
                            <input type="hidden" name= "bookingId" value= "@booking.BookingId"/>
                            <button type="submit" class "btn btn-danger btn-sm">
                                onclick="return confirm('Er du sikker på at du vil kansellere bookingen?');">
                                Kanseller
                            </button>
                            </form>
                        </td>
                     </tr>
                }
                </tbody>
            </table>
        </div>
    }
                <a asp-controller = "RoomLocation"
            asp-action="="Index"
        class "btn btn-secondary">
        Tilbake til lokasjoner
    </a>