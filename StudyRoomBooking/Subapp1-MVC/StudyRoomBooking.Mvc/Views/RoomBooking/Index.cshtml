@model List<StudyRoomBooking.Mvc.viewModel.RoomBookingDetailsViewModel>

@{
    ViewData["Title"] = "Booking oversikt";
}

<div class="container mt-4">
  <h1 class="room-page-title">Bookingoversikt</h1>
    <p class="text-muted">
        Oversikt over planlagte bookinger.
    </p>

 @*Viser bekreftelse etter sletting av booking *@
    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success" role="alert">
            @message
        </div>
    }
    @* Viser feilmelding dersom sletting av en booking mislykkes. *@
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger fw-bold" role="alert">
            @errorMessage
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Det er ingen registrerte bookinger ennå.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var booking in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                @booking.Course
                            </h5>

                            <p class="card-text">
                                <strong>Rom:</strong> @booking.RoomName
                            </p>

                            <p>
                                <strong>Starttid:</strong>
                                @booking.StartTime.ToString("dd MMM yyyy HH:mm")
                            </p>

                            <p>
                                <strong>Sluttid:</strong>
                                @booking.EndTime.ToString("dd MMM yyyy HH:mm")
                            </p>

                            <a asp-controller="RoomBooking"
                               asp-action="Details"
                               asp-route-id="@booking.Id"
                               class="btn room-search-button">
                                Vis detaljer
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
