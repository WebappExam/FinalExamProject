@model StudyRoomBooking.Mvc.viewModel.RoomBookingEditViewModel

@{
    ViewData["Title"] = "Rediger booking";
}

 <div class="room-page">
    <h1 class="room-page-title">Rediger booking</h1>

    <p class="text-muted">
        Rom: @Model.RoomName
    </p>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="booking-form">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="StartTime" class="form-label">Starttid</label>

            <input asp-for="StartTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />

            <span asp-validation-for="StartTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="EndTime" class="form-label">Sluttid</label>

            <input asp-for="EndTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />

        <span asp-validation-for="EndTime" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NumberOfParticipants" class="form-label">
                Number of participants
            </label>

            <input asp-for="NumberOfParticipants"
                   type="number"
                   min="1"
                   class="form-control" />

            <span asp-validation-for="NumberOfParticipants"
                  class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Course" class="form-label">Kursnavn(valgfritt)</label>

            <input asp-for="Course" class="form-control" />

            <span asp-validation-for="Course" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Beskrivelse (obligatorisk)</label>

            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <small class="text-muted d-block">Maks 200 tegn.</small>
            <span asp-validation-for="Description" class="text-danger fw-bold"></span>
        </div>

        <div class="booking-form-actions">
            <button type="submit" class="btn room-search-button">
                Lagre endringer
            </button>

            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-dark">
                Avbryt
            </a>
        </div>
    </a>
</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
