
@model StudyRoomBooking.Mvc.viewModel.RoomBookingDetailsViewModel

@{
    ViewData["Title"] = "Slett booking";
}

<div class="container mt-4">
    <div class="card shadow-sm border-danger">
        <div class="card-body p-4">

            <h2 class="text-danger">Slett booking</h2>

            <div class="alert alert-warning mt-3">
                Er du sikker på at du vil slette denne bookingen?
                Denne handlingen kan ikke angres.
            </div>

            <dl class="row">
                <dt class="col-sm-3">Kurs</dt>
                <dd class="col-sm-9">@Model.Course</dd>

                <dt class="col-sm-3">Rom</dt>
                <dd class="col-sm-9">@Model.RoomName</dd>

                <dt class="col-sm-3">Start</dt>
                <dd class="col-sm-9">
                    @Model.StartTime.ToString("dd.MM.yyyy HH:mm")
                </dd>

                <dt class="col-sm-3">Slutt</dt>
                <dd class="col-sm-9">
                    @Model.EndTime.ToString("dd.MM.yyyy HH:mm")
                </dd>
            </dl>

            <form asp-action="Delete"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit" class="btn btn-danger">
                    Ja, slett booking
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    Avbryt
                </a>
            </form>

        </div>
    </div>
</div>
