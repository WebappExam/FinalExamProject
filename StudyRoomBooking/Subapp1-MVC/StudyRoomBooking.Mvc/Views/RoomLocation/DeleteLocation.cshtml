@model StudyRoomBooking.Mvc.Models.Location

@{
    ViewData["Title"] = "Slett lokasjon";
}

<div class="room-page">
    <h1 class="room-page-title">Slett lokasjon</h1>

    <div class="booking-form">

        <div asp-validation-summary="ModelOnly"
        class="text-danger mb-3"></div>

        @if (Model.Rooms.Any())
        {
            <div class="alert alert-danger">
                Denne lokasjonen har @Model.Rooms.Count rom
                og kan ikke slettes før rommene er fjernet.
            </div>
        }
        else
        {
            <p>
                Er du sikker på at du vil slette
                <strong>@Model.Name</strong>?
            </p>
        }

        <div class="booking-form-actions">

            @if (!Model.Rooms.Any())
            {
                <form asp-action="DeleteLocation" asp-route-id="@Model.LocationId" method="post">

                    <button type="submit" class="btn btn-danger">
                        Ja, slett lokasjon
                    </button>
                </form>
            }

            <a asp-action="Index" class="btn btn-outline-dark">
                Avbryt
            </a>
        </div>
    </div>
</div>