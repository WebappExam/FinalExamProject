@model StudyRoomBooking.Mvc.viewModel.LocationBuildingsViewModel

<h1 class="room-page-title">Velg bygg på @Model.LocationName</h1>
<a asp-action="Index" class="btn btn-outline-dark">Tilbake til lokasjoner</a>

<div class="row g-4 mt-2">
    @foreach (var building in Model.Buildings)
    {
        <div class="col-md-4">
         <div class="card h-100 location-card">
                <div class="card-body">
                    <h2 class="h4">@building</h2>
                    <a asp-action="Rooms"
                       asp-route-locationId="@Model.LocationId"
                       asp-route-building="@building"
                       class="btn room-search-button">
                        Se rom
                    </a>
                </div>
            </div>
        </div>
    }
</div>