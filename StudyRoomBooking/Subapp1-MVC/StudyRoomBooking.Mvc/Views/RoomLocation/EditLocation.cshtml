@model StudyRoomBooking.Mvc.viewModel.LocationFormViewModel

@{
    ViewData["Title"] = "Rediger lokasjon";
}

<div class="room-page">
    <h1 class="room-page-title">Rediger lokasjon</h1>

    <form asp-action="EditLocation" asp-route-id="@Model.LocationId" method="post" class="booking-form">

        <input asp-for="LocationId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Lokasjonsnavn
            </label>

            <input asp-for="Name" class="form-control" />

            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="booking-form-actions">
            <button type="submit" class="btn room-search-button">
                Lagre endringer
            </button>

            <a asp-action="Index" class="btn btn-outline-dark">
                Avbryt
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
