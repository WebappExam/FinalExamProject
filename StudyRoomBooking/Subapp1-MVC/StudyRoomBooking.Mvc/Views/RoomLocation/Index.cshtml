@model List<StudyRoomBooking.Mvc.viewModel.LocationViewModel>

@{
    ViewData["Title"] = "Velg lokasjon";
}

<div class="room-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="room-page-title">Book et grupperom</h1>
            <p class="text-muted">
                Velg hvor du ønsker å finne rom.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <!-- Location creation -->
            <a asp-controller="RoomLocation" asp-action="CreateLocation" class="btn room-search-button">
                + Legg til lokasjon
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] is string message)
    {
        <div class="alert alert-success" role="alert">
            @message
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Ingen lokasjoner er lagt til ennå.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var location in Model)
            {
                <div class="col-md-4">
                    <div class="card h-100 location-card"">
                        <div class=" card-body">

                            <h2 class="h4">
                                @location.LocationName
                            </h2>

                            <p class="text-muted">
                                Se tilgjengelige grupperom på denne lokasjonen.
                            </p>

                            <div class="location-actions">

                                <!-- Existing room navigation -->
                                <a asp-controller="RoomLocation" asp-action="Buildings" asp-route-locationId="@location.LocationId"
                                   class="btn room-search-button">
                                    Se rom
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <!-- Edit location -->
                                    <a asp-controller="RoomLocation" asp-action="EditLocation" asp-route-id="@location.LocationId"
                                       class="btn btn-outline-dark">
                                        Rediger
                                    </a>

                                    <!-- Delete location -->
                                    <a asp-controller="RoomLocation" asp-action="DeleteLocation" asp-route-id="@location.LocationId"
                                       class="btn btn-outline-danger">
                                        Slett
                                    </a>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
