@model List<StudyRoomBooking.Mvc.viewModel.LocationViewModel>

@{
    ViewData["Title"] = "Velg lokasjon";
}

<h1>Book et grupperom</h1>
<p>Velg hvor du ønsker å finne rom.</p>

@if (Model.Count == 0)
{
    <p>Ingen lokasjoner er lagt til ennå.</p>
}
else
{
    <div class="row">
        @foreach (var location in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h2 class="h4">@location.LocationName</h2>

                        <a href="@Url.Action("Rooms", "RoomLocation",
                                     new { locationId = location.LocationId })"
                           class="btn btn-primary">
                            Se rom
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}