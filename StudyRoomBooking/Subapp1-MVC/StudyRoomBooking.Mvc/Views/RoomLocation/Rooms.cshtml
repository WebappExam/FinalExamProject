@model StudyRoomBooking.Mvc.viewModel.LocationViewModel

@{
    ViewData["Title"] = $"Rom på {Model.LocationName}";
}

<h1 class="room-page-title">Rom på @Model.LocationName</h1>

<a href="@Url.Action("Index", "RoomLocation")" class="btn btn-outline-dark">
    Tilbake til lokasjoner

</a>
 @if (User.IsInRole("Admin"))
{
    @*Åpner skjema for oprettelse med valgt lokasjon*@
    <a asp-controller="RoomLocation" asp-action="Create" asp-route-locationId="@Model.LocationId"
       class="btn room-search-button ms-3">
        Opprett nytt rom
    </a>
    }

    @*Søker etter romnavn for valgt lokasjon*@
    <form asp-controller="RoomLocation" asp-action="Rooms" method="get" class="room-search-panel">

        <input type="hidden" name="locationId" value="@Model.LocationId" />
        <div class="room-search-fields">
            <div>
                <label for="searchQuery" class="form-label"> Søk etter romnavn:</label>
                <input type="text" id="searchQuery" name="searchQuery" value="@Model.SearchQuery" class="form-control"
                       placeholder="Skriv romnavn" />
            </div>

            @*Beholder bygg filter i felt etter søk*@
            <div>
                <label for="building" class="form-label">Bygg:</label>
                <input type="text" id="building" name="building" value="@Model.Building" class="form-control"
                       placeholder="Skriv bygg" />
            </div>

            @*Filtrer på minst antall plasser i rommet*@
            <div>
                <label for="minCapacity" class="form-label">Minste kapasitet:</label>
                <input type="number" id="minCapacity" name="minCapacity" value="@Model.MinCapacity" min="1" step="1"
                       class="form-control" placeholder="Skriv minste kapasitet" />
            </div>


            @* Velg ønsket tidsperiode for rombooking *@
            <div>
                <label for="startTime" class="form-label mt-3">
                    Starttidspunkt:
                </label>
                <input type="datetime-local" id="startTime" name="startTime"
                       value="@(Model.StartTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
            </div>

            <div>
                <label for="endTime" class="form-label mt-3">
                    Sluttidspunkt:
                </label>
                <input type="datetime-local" id="endTime" name="endTime"
                       value="@(Model.EndTime?.ToString("yyyy-MM-ddTHH:mm"))" class="form-control" />
            </div>
        </div>

        @* Vis bare rom som er ledige i valgt tidsperiode *@

        <div asp-validation-summary="All" class="text-danger fw-bold mt-3 mb-2"></div>
        <div class="form-check mt-3">

            <input type="checkbox" id="onlyAvailable" name="onlyAvailable" value="true" checked="@Model.OnlyAvailable"
                   class="form-check-input" />

            <label for="onlyAvailable" class="form-check-label">
                Vis kun ledige rom
            </label>
        </div>

        <button type="submit" class="btn room-search-button mt-2">Søk</button>
    </form>

    @if (!ViewData.ModelState.IsValid) @*eks condition rendering - Feilmelding vises og romlisten skjules*@
    {
        @*Romlisten skjules når søk er ugyldig*@
    }
    else if (Model.Rooms.Count == 0)
    {
        <p>Ingen rom å vise på denne lokasjonen. Søk på nytt eller tøm søkefeltet.</p>
    }
    else
    {
        <div class="row mt-3">
            @foreach (var room in Model.Rooms)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100 location-card">
                        <div class="card-body">
                            <h2 class="h5">@room.RoomName</h2>
                            <p>Kapasitet: @room.Capacity personer</p>
                            <p>Bygg: @room.Building</p>
                            <p>Romtype: @room.RoomType</p>


                            @if (Model.StartTime.HasValue &&
                                 Model.EndTime.HasValue &&
                                Model.StartTime.Value < Model.EndTime.Value)
                            {
                                <p>
                                    Status:
                                    <span class="@(Model.OccupiedRoomIds.Contains(room.RoomId) ? "text-danger" : "text-success")">
                                        @(Model.OccupiedRoomIds.Contains(room.RoomId) ? "● Opptatt" : "● Ledig")
                                    </span>
                                </p>
                            }
                            else
                            {
                                <p class="text-muted">
                                    Velg en tidsperiode for å se ledighet.
                                </p>
                            }

                            <div class="location-actions">


                                @if (User.IsInRole("Admin"))
                                {
                                @*Åpner skjema for oppdatering av rom*@
                                <a asp-controller="RoomLocation" asp-action="Update" asp-route-roomId="@room.RoomId"
                                   class="btn btn-outline-dark">
                                    Rediger
                                </a>

                                @*Åpner skjema for sletting av rom*@
                                <a asp-controller="RoomLocation" asp-action="Delete" asp-route-roomId="@room.RoomId"
                                   class="btn btn-outline-danger">
                                    Slett
                                </a>
                                }
                                @*Åpner bookingskjema for valgt rom*@
                                <a asp-controller="RoomBooking" asp-action="Create" asp-route-roomId="@room.RoomId"
                                   class="btn room-search-button">
                                    Book rom
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }