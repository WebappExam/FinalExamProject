@model StudyRoomBooking.Mvc.viewModel.LocationViewModel

@{
    ViewData["Title"] = $"Rom på {Model.LocationName}";
}

<h1>Rom på @Model.LocationName</h1>

<a href="@Url.Action("Index", "RoomLocation")">
    Tilbake til lokasjoner

</a>

@*Åpner skjema for oprettelse med valgt lokasjon*@
<a asp-controller="RoomLocation" 
   asp-action="Create" 
   asp-route-locationId="@Model.LocationId" 
   class="btn btn-primary ms-3">
    Opprett nytt rom
</a>

@*Søker etter romnavn for valgt lokasjon*@
<form asp-controller="RoomLocation" asp-action="Rooms" method="get" class="mt-3 mb-3">
   
    <input type="hidden" name="locationId" value="@Model.LocationId" />
    <label for="searchQuery" class ="form-label"> Søk etter romnavn:</label>
    <input type="text" 
    id ="searchQuery" 
    name ="searchQuery"
    value="@Model.SearchQuery"
    class="form-control" 
    placeholder="Skriv romnavn" />

    @*Beholder bygg filter i felt etter søk*@
    <label for="building" class="form-label mt -3">Bygg:</label>
    <input type="text" 
           id="building" 
           name="building" 
           value="@Model.Building"
           class="form-control" 
           placeholder="Skriv bygg" />

    @*Filtrer på minst antall plasser i rommet*@
    <label for="minCapacity" class="form-label mt-3">Minste kapasitet:</label>
    <input type="number" 
           id="minCapacity" 
           name="minCapacity" 
           value="@Model.MinCapacity"
           min="1"
           step="1"
           class="form-control" 
           placeholder="Skriv minste kapasitet" />

           
@* Velg ønsket tidsperiode for rombooking *@
<label for="startTime" class="form-label mt-3">
    Starttidspunkt:
</label>
<input type="datetime-local"
       id="startTime"
       name="startTime"
       value="@(Model.StartTime?.ToString("yyyy-MM-ddTHH:mm"))"
       class="form-control" />

<label for="endTime" class="form-label mt-3">
    Sluttidspunkt:
</label>
<input type="datetime-local"
       id="endTime"
       name="endTime"
       value="@(Model.EndTime?.ToString("yyyy-MM-ddTHH:mm"))"
       class="form-control" />

@* Vis bare rom som er ledige i valgt tidsperiode *@

    <div asp-validation-summary="All" class="text-danger fw-bold mt-3 mb-2"></div>
    <div class="form-check mt-3">

    <input type="checkbox"
           id="onlyAvailable"
           name="onlyAvailable"
           value="true"
           checked="@Model.OnlyAvailable"
           class="form-check-input" />

    <label for="onlyAvailable" class="form-check-label">
        Vis kun ledige rom
    </label>
</div>

    <button type="submit" class="btn btn-primary mt-2">Søk</button>
    </form>

@if (!ViewData.ModelState.IsValid) @*eks condition rendering - Feilmelding vises og romlisten skjules*@
{
   @*Romlisten skjules når søk er ugyldig*@
}
else if (Model.Rooms.Count == 0)
{
    <p>Ingen rom å vise på denne lokasjonen. Søk på nytt eller tøm søkefeltet.</p>
}
else
{
    <div class="row mt-3">
        @foreach (var room in Model.Rooms)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h2 class="h5">@room.RoomName</h2>
                        <p>Capacity: @room.Capacity persons</p>
                        <p>Building: @room.Building</p>
                        <p>Room type: @room.RoomType</p>

                        
                        @if (Model.StartTime.HasValue &&
                             Model.EndTime.HasValue &&
                            Model.StartTime.Value < Model.EndTime.Value)
                            {
                                <p>
                                     Status:
                                     <span class="@(Model.OccupiedRoomIds.Contains(room.RoomId) ? "text-danger" : "text-success")">
                                        @(Model.OccupiedRoomIds.Contains(room.RoomId) ? "● Opptatt" : "● Ledig")
                                        </span>
                                        </p>
                                        }
                                        else
                                        {
                                            <p class="text-muted">
                                                Velg en tidsperiode for å se ledighet.
                                                </p>
                                                }

                        @*Åpner skjema for oppdatering av rom*@
                        <a asp-controller="RoomLocation" 
                           asp-action="Update" 
                           asp-route-roomId="@room.RoomId" 
                           class="btn btn-primary">
                            Rediger
                        </a>
                        @*Åpner skjema for sletting av rom*@
                        <a asp-controller="RoomLocation"
                           asp-action="Delete" 
                           asp-route-roomId="@room.RoomId" 
                           class="btn btn-danger">
                            Slett
                        </a>
                        @*Åpner bookingskjema for valgt rom*@
                        <a asp-controller="RoomBooking" 
                           asp-action="Create" 
                           asp-route-roomId="@room.RoomId" 
                           class="btn btn-success">
                            Book rom
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}