@{
    ViewData["Title"] = "Hjem";
}

<div class="home-hero">

    <section class="home-intro">

        <h1 class="home-title">
            Et godt sted å tenke sammen.
        </h1>

        <p class="home-description">
            Finn et grupperom som passer for deg. Søk etter bygg,
            kapasitet og ledighet — alt på ett sted.
        </p>

        <a asp-controller="RoomLocation"
           asp-action="Index"
           class="btn home-search-button">
            Finn ledige rom
        </a>

    </section>

    <img src="~/images/rom.jpg"
         alt="Grupperom med plass til samarbeid"
         class="home-image" />

</div>